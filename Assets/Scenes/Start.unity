--- !u!114 &2143115493
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2143115491}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: baa5f1cd5aae64e4d911d73c35a16f01, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "\uC544\uC800\uC528 \uC544\uC800\uC528\uB294 \uBB50 \uC88B\uC544\uD574\uC694?"
    - "\uB098..? \uB09C \uC74C... \uC798 \uBAA8\uB974\uACA0\uB294\uB370..."
    - "\uC804 \uC7A5\uB09C\uAC10\uC774\uB791 \uC0AC\uD0D5\uC774\uB791 \uC778\uD615\uC744
      \uC88B\uC544\uD574\uC694!"
    - "\uC81C \uCE5C\uAD6C\uB4E4\uB3C4 \uB2E4 \uC88B\uC544\uD560\uAC78\uC694?!"
    - "(\uC544\uC774\uB294 \uC6C3\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uC544\uC800\uC528! \uADF8\uAC70 \uD639\uC2DC \uC0AC\uD0D5\uC774\uB791 \uC7A5\uB09C\uAC10\uC774\uB791
      \uC778\uD615\uC774\uC5D0\uC694?!"
    - "\uC800\uD55C\uD14C \uADF8\uAC70 \uC8FC\uBA74 \uC81C\uAC00 \uC88B\uC740\uAC70
      \uB4DC\uB9B4\uAC8C\uC694!"
    - "(\uC544\uC774\uC5D0\uAC8C \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC78 \uC8FC\uBA74
      \uBB54\uAC00\uB97C \uBC1B\uC744 \uC218 \uC788\uC744 \uAC70 \uAC19\uB2E4.)"
    sprites:
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_3:
    sentences:
    - "(\uADF8\uB9CC\uB450\uC790.)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_4:
    sentences:
    - "\uC640\uC544! \uACE0\uB9C8\uC6CC\uC694!"
    - "(\uC544\uC774\uB294 \uB0A0 \uAF49 \uC548\uC544\uC8FC\uC5C8\uB2E4.)"
    - "\uC548\uC544\uC8FC\uBA74 \uAE30\uBD84\uC774 \uC88B\uC544\uC838\uC694!"
    - "(\uAC00\uC2B4\uC774 \uB530\uB4EF\uD574\uC9C0\uB294 \uB290\uB08C\uC774\uB2E4.)"
    - "(...\uBB34\uC5B8\uAC00\uB97C \uC5BB\uC740\uAC70 \uAC19\uB2E4.)"
    - "(I\uD0A4\uB97C \uB20C\uB7EC \uC544\uC774\uD15C\uC744 \uD655\uC778\uD574\uBCF4\uC790.)"
    sprites:
    - {fileID: -1605133020, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 770997799, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_5:
    sentences:
    - "\uC548\uC544\uC8FC\uBA74 \uAE30\uBD84\uC774 \uC88B\uC544\uC838\uC694!"
    - "(\uC544\uC774\uB294 \uAE30\uC05C \uB4EF \uC6C3\uACE0 \uC788\uB2E4.)"
    sprites:
