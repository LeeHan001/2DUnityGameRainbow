  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ceb8cb6a1d80bd147b1e553d1b70a898, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "(\uD3C9\uBC94\uD55C \uCC45\uC0C1\uC774\uB2E4.)"
    - "(\uCC45\uC0C1\uC704\uC5D0\uB294 \uC885\uC774\uB4E4\uC774 \uC788\uB2E4.)"
    - "(\uC885\uC774\uC5D0\uB294 \uC774\uB807\uAC8C \uC801\uD600\uC838\uC788\uB2E4.)"
    - "\uC804\uC790\uAE30\uD30C, \uBE5B\uC758 \uC885\uB958\uB294 \uC5EC\uB7EC\uAC00\uC9C0\uB2E4."
    - "\uC9E7\uC740 \uD30C\uC7A5\uC5D0\uC11C \uAE34 \uD30C\uC7A5 \uC21C\uC11C\uB85C"
    - "\uAC10\uB9C8\uC120, X\uC120, \uC790\uC678\uC120, \uAC00\uC2DC\uAD11\uC120,
      \n\uC801\uC678\uC120, \uC804\uD30C\uAC00 \uC788\uB2E4."
    - "\uADF8 \uC911 \uAC00\uC2DC\uAD11\uC120\uC740 \uC778\uAC04\uC758 \uB208\uC73C\uB85C
      \n\uAC10\uC9C0\uAC00 \uAC00\uB2A5\uD55C \uC601\uC5ED\uC774\uB2E4."
    - "(\uC885\uC774\uC5D0 \uC801\uD600\uC9C4 \uB0B4\uC6A9\uC778 \uC774\uAC8C \uB2E4\uC778
      \uB4EF\uD558\uB2E4.)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
