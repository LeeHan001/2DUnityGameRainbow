  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "\uD558\uC544..."
    - "(\uAE4A\uC740 \uD55C\uC228\uC744 \uC26C\uACE0 \uC788\uB2E4.)"
    - "\uC74C...? \uC2E0\uC785\uC774\uB2C8?"
    - "\uC5B4...\uC544\uB2CC\uB370\uC694..."
    - "\uADF8\uB798?...\uD558\uC544..."
    - "\uD639\uC2DC \uB098\uB97C \uC880 \uB3C4\uC640\uC904 \uC218 \uC788\uB2C8..?"
    - "\uB3C4\uC640\uC8FC\uBA74 \uC774 \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uC911\uC694\uD55C
      \uAC78 \uC904\uAC8C."
    - "\uC55E\uC5D0 \uC788\uB294 \uC0AC\uB78C\uB4E4\uD55C\uD14C \uBB3C\uC5B4\uBD10\uC11C
      \uC77C\uC744 \uBC1B\uC544\uC11C \uD558\uBA74 \uB3FC."
    - "\uC880 \uC26C\uACE0 \uC2F6\uB2E4...\uD558\uC544.."
    - "(\uB0A8\uC790\uB294 \uCDA9\uC5F4\uB41C \uB208\uC73C\uB85C \uD55C\uC228\uC744
      \uC26C\uACE0 \uC788\uB2E4...)"
