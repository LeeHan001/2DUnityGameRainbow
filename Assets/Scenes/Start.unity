    - "(\uC774\uC81C \uC2DC\uD5D8\uC740 \uC548\uBD10\uB3C4 \uB420\uAC70 \uAC19\uB2E4.)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  answer_check: 0
  choice_0:
    question: "\uC2DC\uD5D8\uC744 \uBCF8\uB2E4."
    answer:
    - "\uADF8\uB9CC\uB454\uB2E4."
    - "\uC2DC\uD5D8\uC744 \uBCF8\uB2E4."
  choice_1:
    question: "\uC778\uAC04\uC758 \uB208\uC73C\uB85C \uAC10\uC9C0\uAC00 \uAC00\uB2A5\uD55C
      \uD30C\uC7A5\uC774\uBA70 \uBB34\uC9C0\uAC1C\uB3C4 \uC774 \uD30C\uC7A5\uC758
      \uAD74\uC808 \uD604\uC0C1\uC785\uB2C8\uB2E4. \uC774 \uD30C\uC7A5\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    answer:
    - "\uAC00\uC2DC\uAD11\uC120"
    - "\uC801\uC678\uC120"
    - "X\uC120"
    - "\uC790\uC678\uC120"
    - "\uAC10\uB9C8\uC120"
  choice_2:
    question: "\uBCF4\uC0C9\uC774\uB77C\uB294 \uAC83\uC740 \uC0C9\uC0C1 \uB300\uBE44\uB97C
      \uC774\uB8E8\uB294 \uD55C\uC30D\uC785\uB2C8\uB2E4.  \uBCF4\uB77C\uC0C9\uC758
      \uBCF4\uC0C9\uC740 \uBB58\uAE4C\uC694?"
    answer:
    - "\uBE68\uAC04\uC0C9"
    - "\uAC08\uC0C9"
    - "\uC5F0\uB450\uC0C9"
    - "\uB178\uB780\uC0C9"
    - "\uB0A8\uC0C9"
  choice_3:
    question: "\uC0C9\uC57D\uC774\uB780 \uC0C9\uC0C1\uC744 \uC798 \uAD6C\uBD84\uD558\uC9C0
      \uBABB\uD558\uB294 \uC99D\uC0C1\uC774\uB2E4. \uC801\uC0C9\uC57D\uC778 \uC0AC\uB78C\uC740
      \uBE68\uAC04\uC0C9\uC744 \uC5B4\uB5A4 \uC0C9\uC73C\uB85C \uBCFC\uAE4C?"
    answer:
    - "\uC9D9\uC740 \uB179\uC0C9"
    - "\uC9D9\uC740 \uBD89\uC740\uC0C9"
    - "\uC9D9\uC740 \uC8FC\uD669\uC0C9"
    - "\uAC80\uC815\uC0C9"
    - "\uD30C\uB780\uC0C9"
  choice_4:
    question: "\uC774\uAC83\uC740 \uC5EC\uB7EC\uC7A5 \uACB9\uCC98 \uAE34 \uD1B5\uC5D0
      \uC6D0\uC0C9\uC758 \uC870\uAC01\uC774\uB098 \uC54C\uB9F9\uC774\uB97C \uB123\uC5B4
      \uD22C\uBA85\uD55C \uC6A9\uAE30\uC5D0 \uBC00\uD3D0\uD574 \uB4E4\uC5EC\uB2E4
      \uBCF4\uB294 \uBB3C\uAC74\uC774\uB2E4. \uC774\uAC83\uC758 \uC774\uB984\uC740?"
    answer:
    - "\uC7A0\uB9CC\uACBD"
    - "\uB9DD\uC6D0\uACBD"
    - "\uD604\uBBF8\uACBD"
    - "\uC548\uACBD"
    - "\uB9CC\uD654\uACBD"
  choice_5:
    question: "\uC624\uB298 \uB0B4\uAC00 \uC785\uC740 \uD32C\uD2F0\uC758 \uC0C9\uC740?"
    answer:
    - "\uCD08\uB85D\uC0C9"
    - "\uAC80\uC815\uC0C9"
    - "\uBE68\uAC04\uC0C9"
    - "\uC5BC\uAD74\uB9CC \uC788\uC5B4\uC11C \uD32C\uD2F0\uB97C \uC785\uC744 \uC218
      \uC5C6\uB2E4."
    - "\uD30C\uB780\uC0C9"
  anim: {fileID: 1408509991}
  direction: UP
  BGM: {fileID: 0}
  theAudio: {fileID: 0}
  Good: GoodSound
  Soso: SosoSound
  Bad: BadSound
