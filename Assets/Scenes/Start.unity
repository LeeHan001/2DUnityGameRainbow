  dialogue_2:
    sentences:
    - ...
    - "\uC9C4\uC9DC \uAE7C\uC5B4\uC694?!"
    - "\uC6B0\uC640! \uC544\uC800\uC528 \uB300\uB2E8\uD558\uB2E4! \uB098\uB294 \uC774\uAC70
