--- !u!114 &226118052
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 226118050}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ceb8cb6a1d80bd147b1e553d1b70a898, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "(\uD3C9\uBC94\uD55C \uCC45\uC0C1\uC774\uB2E4.)"
    - "(\uCC45\uC0C1\uC704\uC5D0\uB294 \uC885\uC774\uB4E4\uC774 \uC788\uB2E4.)"
    - "(\uC885\uC774\uC5D0\uB294 \uC774\uB807\uAC8C \uC801\uD600\uC838\uC788\uB2E4.)"
    - "\uBCF4\uC0C9\uC740 \uC11C\uB85C \uBC18\uB300\uB418\uB294 \uC0C9\uC774\uB2E4.\n\uBCF4\uC0C9\uC740
      \uB450 \uBE5B\uC744 \uD569\uD560 \uB54C \uBB34\uCC44\uC0C9\uC774 \uB418\uB294
      \n\uC0C9\uC774\uB77C\uACE0 \uD560 \uC218 \uC788\uB2E4. "
    - "\uBCF4\uC0C9\uC5D0\uB294 \uBE68\uAC04\uC0C9 - \uCCAD\uB85D\uC0C9, \uC8FC\uD669\uC0C9
      - \uD30C\uB780\uC0C9,\n\uB178\uB780\uC0C9 - \uB0A8\uC0C9, \uC5F0\uB450\uC0C9
      - \uBCF4\uB77C\uC0C9\uC774 \uC788\uB2E4."
    - "(\uC885\uC774\uC5D0 \uC801\uD600\uC9C4 \uB0B4\uC6A9\uC778 \uC774\uAC8C \uB2E4\uC778
      \uB4EF\uD558\uB2E4.)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
