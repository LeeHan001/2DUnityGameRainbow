  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6930ad2666ee3bd41b8fe831db44ebf8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "(\uD3C9\uBC94\uD55C \uAD50\uD0C1\uC774\uB2E4...)"
    - "(\uAD50\uD0C1 \uC704\uC5D0\uB294 \uC2DC\uD5D8\uC9C0\uAC00 \uAC00\uB4DD\uD558\uB2E4.)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_1:
    sentences:
    - ...
    - "\uCC98\uC74C\uBCF4\uB294 \uD559\uC0DD\uC774\uAD70. \n\uC624\uB298 \uC2DC\uD5D8\uC778\uAC70
      \uC54C\uACE0 \uC788\uB2C8?"
    - "(\uAC70\uB300\uD55C \uC5BC\uAD74\uC774 \uAC11\uC790\uAE30 \uB098\uD0C0\uB0AC\uB2E4.)"
    - "(\uC774\uAC8C...\uC120\uC0DD\uB2D8\uC778\uAC00..?)"
    - "\uB124...\uB124!"
    - "\uC88B\uC544. \uB2F9\uC7A5 \uC2DC\uD5D8\uC744 \uBCFC\uAC70\uB2C8? \n\uC544\uB2C8\uBA74
      \uC870\uAE08 \uB354 \uC900\uBE44\uB97C \uD560\uAC70\uB2C8?"
    sprites:
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uC2DC\uD5D8\uC744 \uBCFC\uAC70\uB2C8?"
    sprites:
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_3:
    sentences:
    - "\uD760...\uC900\uBE44\uAC00 \uD544\uC694\uD55C\uAC00 \uBCF4\uAD70.\n\uB354
      \uACF5\uBD80\uD574\uC624\uB834."
    sprites:
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_4:
    sentences:
    - "\uC88B\uC544. \uBC14\uB85C \uC2DC\uD5D8\uC744 \uBCF4\uB3C4\uB85D \uD558\uC790. "
    - "\uCC38\uACE0\uB85C \uBAA8\uB4E0 \uBB38\uC81C\uB97C \uB2E4 \n\uB9DE\uC544\uC57C\uB9CC
      \uB098\uAC08 \uC218 \uC788\uB2E8\uB2E4."
    sprites:
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_5:
    sentences:
    - "(\uC120\uC0DD\uB2D8\uC758 \uB208\uAF2C\uB9AC\uAC00 \uC0B4\uC9DD \uB0B4\uB824\uAC14\uB2E4.)"
    sprites:
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_6:
    sentences:
    - "(\uC120\uC0DD\uB2D8\uC740 \uC624\uBB18\uD55C \uD45C\uC815\uC744 \uC9D6\uB294\uB2E4.)"
    sprites:
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_7:
    sentences:
    - ...
    - "\uCD95\uD558\uD55C\uB2E4. \uB2E4 \uB9DE\uCDC4\uAD6C\uB098."
    - "(\uC120\uC0DD\uB2D8\uC740 \uC6C3\uACE0 \uC788\uB2E4.)"
    - "\uC5B4\uB824\uC6B4 \uC2DC\uD5D8\uC778\uB370 \uB2E4 \uB9DE\uCD94\uB2E4\uB2C8
      \uB300\uB2E8\uD558\uAD6C\uB098."
    - "\uC774\uB7F0 \uC5B4\uB824\uC6B4 \uC2DC\uD5D8\uC744 \uD574\uB0B8 \uB108\uB294
      \n\uBD84\uBA85 \uBB34\uC5C7\uC774\uB4E0 \uC774\uACA8\uB0BC \uC218 \uC788\uC5B4."
    - "(\uC120\uC0DD\uB2D8\uC740 \uD658\uD558\uAC8C \uC6C3\uACE0\uC788\uB2E4.)"
    sprites:
    - {fileID: 1368770266, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: 1368770266, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: 1368770266, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: 1368770266, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: 1368770266, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: 1368770266, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_8:
    sentences:
    - ...
    - "\uC798\uD588\uC9C0\uB9CC \uC870\uAE08 \uB354 \uB178\uB825\uD574\uC57C \uACA0\uAD6C\uB098."
    - "\uC870\uAE08 \uB354 \uACF5\uBD80\uD558\uACE0 \uC624\uB834"
    - "(\uC120\uC0DD\uB2D8\uC740 \uBBF8\uC18C\uB97C \uC9D3\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: -644712679, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: -644712679, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: -644712679, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    - {fileID: -644712679, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
    dialogueWindows:
