  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "...\uC544\uC800\uC528 \uC5B4\uB514\uAC00\uC694..?"
    - "...\uC6D0\uB798 \uC788\uB358 \uC7A5\uC18C\uB85C \uB3CC\uC544\uAC04\uB2E4\uACE0\uC694..?"
    - "\uADF8\uB7FC \uC774\uC81C \uBABB \uBCF4\uB294 \uAC70\uB124\uC694..."
    - "(\uC18C\uB144\uC740 \uC2DC\uBB34\uB8E9\uD55C \uD45C\uC815\uC774\uB2E4.)"
    - "\uADF8\uB798\uB3C4 \uC544\uC800\uC528\uB294 \uB611\uB611\uD558\uB2C8\uAE4C
      \uBD84\uBA85 \n\uBB50\uB4E0 \uC798 \uD560 \uC218 \uC788\uC744\uAC70\uC5D0\uC694!"
    - "(\uC18C\uB144\uC740 \uC6C3\uC73C\uBA70 \uB9D0\uD588\uB2E4.)"
    - "\uC544..!"
    - "\uC774\uAC70 \uBC1B\uC544\uC694!"
    - "(\uC18C\uB144\uC740 \uCD08\uB85D\uC0C9 \uB3CC\uC744 \uAC74\uB0C8\uB2E4.)"
    - "\uC544\uC800\uC528\uB294 \uB611\uB611\uD558\uB2C8\uAE4C \uAD1C\uCC2E\uACA0\uC9C0\uB9CC,\n\uD639\uC2DC\uB098
      \uD798\uB4E4\uB54C \uC774 \uB3CC\uC774 \uB3C4\uC640\uC904\uAC70\uC5D0\uC694."
    - "(\uC18C\uB144\uC740 \uC6C3\uC73C\uBA70 \uB9D0\uD588\uB2E4.)"
    sprites:
    - {fileID: -876725661, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
