  dialogue_3:
    sentences:
    - "\uC6B0\uC720...?"
    - "\uD558\uD558\uD558\uD558\uD558\uD558\uD558\uD558"
    - "\uC9C4\uC9DC \uC5B4\uC774\uAC00 \uC5C6\uAD70...\uC800\uAE30 \uC788\uB294 \uC544\uAE30\uD55C\uD14C\uB77C\uB3C4
      \uAC00\uC838\uB2E4 \uC8FC\uBA74 \uC5B4\uB54C?"
