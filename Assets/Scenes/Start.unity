  dialogue_2:
    sentences:
    - ...
    - "\uC9C4\uC9DC \uAE7C\uC5B4\uC694?!"
    - "\uC6B0\uC640! \uC544\uC800\uC528 \uB300\uB2E8\uD558\uB2E4! \uB098\uB294 \uC774\uAC70
      \uBA87 \uBC88\uC744 \uD588\uB294\uB370 \uBABB \uAE7C\uB294\uB370!"
    - "\uB098\uB3C4 \uC544\uC800\uC528\uCC98\uB7FC \uBA4B\uC9C4 \uC0AC\uB78C\uB418\uACE0
      \uC2F6\uB2E4!"
    - "(\uC544\uC774\uB294 \uAE30\uC05C \uB4EF\uC774 \uC6C3\uACE0 \uC788\uB2E4.)"
    - "\uC544\uC800\uC528\uC5D0\uAC8C \uC774\uAC70 \uC120\uBB3C\uB85C \uC904\uAC8C\uC694!"
