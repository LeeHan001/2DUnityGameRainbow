  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "...\uC5B4\uB514\uAC00\uB2C8?"
    - "\uB2E4\uC2DC \uB3CC\uC544\uAC08\uAC70\uB77C\uACE0..?"
    - "\uD760..."
    - "\uC5B4\uB514\uB85C \uB3CC\uC544\uAC00\uC57C \uD560 \uC9C0\uB294 \uC54C\uACE0
      \uC788\uB2C8..?"
    - "...\uAE00\uC384\uC694...\uCC3E\uC544\uBD10\uC57C\uC8E0."
    - "\uADF8\uB798...\uC5EC\uB7EC \uC77C\uB4E4\uC744 \uD574\uB0B8 \uB108\uB77C\uBA74
      \uC798 \uD558\uACA0\uC9C0."
    - "...\uC544 \uC774\uAC78 \uC904\uAC8C."
    - "(\uB0A8\uC790\uB294 \uB0A8\uC0C9 \uB3CC\uC744 \uAC74\uB0C8\uB2E4.)"
    - "\uB108\uB77C\uBA74 \uC798 \uD574\uB0BC \uC218 \uC788\uC744\uAC70\uC57C."
