  dialogue_4:
    sentences:
    - (...)
    - "(...\uB5A0\uC62C\uB790\uB2E4.)"
    - "(\uB09C...\uC8FD\uC73C\uB824\uACE0 \uD588\uB2E4.)"
    - "(\uB098\uBB34\uC5D0 \uBC27\uC904\uC744 \uBB36\uC5B4 \uC8FD\uC73C\uB824\uACE0
      \uD588\uB2E4.)"
    - "(\uC0DD\uAC01\uD574 \uBCF4\uB2C8 \uB0B4 \uC778\uC0DD\uC740 \uC544\uBB34\uAC83\uB3C4
      \uC5C6\uC5C8\uB2E4.)"
    - "(\uD0DC\uC5B4\uB098\uC11C\uBD80\uD130 \uD63C\uC790\uC600\uACE0.)"
    - "(\uC5B4\uB9B4 \uB54C\uB294 \uCE5C\uAD6C\uB77C\uACE0\uB294 \uC544\uBB34\uB3C4
      \uC5C6\uC5C8\uB2E4.)"
    - "(\uC0AC\uCD98\uAE30\uB97C \uC9C0\uB0A0 \uB54C\uB294 \uAC8C\uC784\uC5D0 \uBE60\uC838.)"
    - "(\uD558\uB8E8\uAC00 \uBA40\uB2E4 \uD558\uACE0 \uAC8C\uC784\uB9CC \uD588\uC5C8\uB2E4.)"
    - "(\uACE0\uB4F1\uD559\uAD50 \uB550 \uACF5\uBD80\uB294 \uC548\uD558\uACE0 \uC120\uC0DD\uB2D8\uD55C\uD14C
      \uD63C\uB098\uAE30\uB9CC \uD588\uB2E4.)"
    - "(\uC5B4\uB978\uC774 \uB418\uBA74 \uC74C\uC545\uC744 \uD558\uB294 \uC0AC\uB78C\uC774
      \uB418\uACE0 \uC2F6\uC5C8\uC9C0\uB9CC.)"
    - "(\uB9C9\uC0C1 \uC131\uC778\uC774 \uB418\uACE0\uB098\uB2C8 \uB450\uB824\uC6C0\uC774
      \uC55E\uC11C \uAFC8\uC744 \uD3EC\uAE30\uD558\uACE0 \uC9D1\uC5D0\uB9CC \uBC15\uD600\uC788\uC5C8\uB2E4.)"
    - "(\uC810\uC810 \uB0B4 \uC815\uC2E0\uC740 \uBB34\uB108\uC838\uB0B4\uB9AC\uAE30
      \uC2DC\uC791\uD588\uACE0 \uD558\uB8E8 \uC885\uC77C \uC544\uBB34\uAC83\uB3C4
      \uC548\uD558\uB294 \uB098\uB0A0\uC758 \uBC18\uBCF5.)"
    - "(\uACA8\uC6B0 \uC815\uC2E0\uC744 \uCC28\uB9AC\uACE0 \uBCF4\uB2C8 \uC80A\uC740\uC740
      \uB2E4 \uC2DC\uB4E4\uC5C8\uACE0 \uB3C8\uC740 \uB2E4 \uB5A8\uC5B4\uC838\uC788\uC5C8\uB2E4.)"
    - "(\uAE09\uD55C \uB300\uB85C \uC77C\uC744 \uD574\uC57C\uD574\uC11C \uCC3E\uC558\uB358
      \uC77C\uC790\uB9AC\uB294 \uD558\uB8E8 \uC885\uC77C \uC77C\uACFC \uC7A0\uC758
      \uBC18\uBCF5.)"
    - "(\uC9C1\uC6D0\uB4E4\uC740 \uB0A0 \uBB34\uC2DC\uD558\uAC70\uB098 \uBCF4\uAE30
      \uC2EB\uB2E4\uB294 \uC5BC\uAD74\uB85C \uCC98\uB2E4\uBCF4\uAE30\uB9CC \uD588\uB2E4.)"
    - "(\uBAA8\uB4E0 \uAC78 \uB2E4 \uB0B4\uD33D\uACA8\uCE58\uACE0 \uC9D1\uC5D0\uC11C
      \uC6B0\uC6B8\uAC10\uC5D0 \uBE60\uC838 \uB0B4 \uC2A4\uC2A4\uB85C\uB97C \uC8FD\uC5EC\uAC14\uB2E4.)"
    - "(\uC6B0\uC6B8\uC99D \uC57D\uB4E4\uACFC \uD53C\uBB4D\uC740 \uCEE4\uD130\uCE7C,
      \uADF8\uB9AC\uACE0 \uBB34\uB825\uD568\uC5D0 \uB204\uC6CC\uC788\uB358 \uB098.)"
    - "(\uADF8\uB0A0 \uB09C \uACB0\uC2EC\uD588\uB2E4. \uC5B4\uB9B4\uB54C \uC88B\uC544\uD558\uB358
      \uC7A5\uC18C\uC5D0\uC11C \uB05D\uC744 \uB0B4\uC790\uACE0.)"
    - "(\uADF8 \uB2E4\uC74C\uC740..?)"
    - "(\uADF8 \uB2E4\uC74C\uC740\uBD80\uD130 \uC5B4\uB5BB\uAC8C \uB41C\uAC70\uC9C0..?)"
    - "(\uB09C \uC8FD\uC740\uAC74\uAC00..?)"
    - "(\uBAA8\uB974\uACA0\uB2E4...\uC774\uC820...)"
    - "(\uB208 \uB728\uB294\uAC8C \uB450\uB824\uC6CC...)"
    - "(\uBC14\uB78C\uC774 \uB290\uAEF4\uC9C4\uB2E4...)"
    - "(\uB208\uAEBC\uD480 \uC0AC\uC774\uB85C \uBE5B\uC774 \uB290\uAEF4\uC9C4\uB2E4...)"
