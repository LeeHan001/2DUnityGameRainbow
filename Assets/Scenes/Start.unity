    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uC544\uC800\uC528 \uB610 \uBAA8\uB974\uB294 \uAC70 \uBB3C\uC5B4\uBD10\uB3C4
      \uB3FC\uC694?\r"
    - "\uADF8\uB798 \uBB3C\uC5B4\uBCF4\uB834."
    - "3 x 3 \uC774 \uBB54\uC9C0 \uC54C\uC544\uC694?"
    - "9\uB780\uB2E4."
    - "\uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694!"
    - "(\uC544\uC774\uB294 \uB610 \uC6C3\uACE0 \uC788\uB2E4.)"
