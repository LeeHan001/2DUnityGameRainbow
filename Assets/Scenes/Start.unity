  dialogue_3:
    sentences:
    - "\uB098 \uC774\uC820 \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uACA0\uC5B4."
    - "\uB108\uAC00 \uC900 \uC774 \uAFC8\uACFC \uD568\uAED8 \uB3C4\uC804\uD560\uAC70\uC57C."
