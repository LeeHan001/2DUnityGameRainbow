  dialogue_2:
    sentences:
    - "\uC55E\uC5D0 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uBB58 \uD574\uC57C\uD558\uB0D0\uACE0
      \uBB3C\uC5B4\uBD10."
    - "\uD558\uC544..."
    - "(\uB0A8\uC790\uB294 \uACC4\uC18D \uD55C\uC228\uC744 \uC26C\uACE0 \uC788\uB2E4...)"
    sprites:
    - {fileID: 1960789594, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1960789594, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
