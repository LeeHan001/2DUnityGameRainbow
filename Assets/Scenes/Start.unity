    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uB0A8\uC790\uC5D0\uAC8C \uC774\uC0C1\uD55C \uBE5B\uC744 \uC92C\uB2E4."
    - "\uC73C...\uC73C\uC73C..."
    - "\uC5B4! \uC774...\uAC74?!!"
    - "(\uB0A8\uC790\uB294 \uAC11\uC790\uAE30 \uD070\uC18C\uB9AC\uB97C \uCCE4\uB2E4.)"
    - "\uC774\uAC74...\uB0B4\uAC00 \uC5B4\uB290\uC21C\uAC04 \uC783\uC5B4\uBC84\uB9B0
      \uAFC8..."
    - "\uC774\uAC8C \uC788\uC5C8\uC744 \uB54C\uB294 \uBB34\uC5C7\uB3C4 \uB450\uB835\uC9C0\uC54A\uACE0
      \n\uC990\uAC70\uC6E0\uC5C8\uB294\uB370..."
    - "\uB09C \uB2E4\uC2DC \uADF8 \uB54C\uB85C \uB3CC\uC544\uAC08 \uC218 \uC788\uC744\uAE4C..."
    - "\uADF8 \uB54C\uCC98\uB7FC \uB3C4\uC804\uD560 \uC218 \uC788\uC744\uAE4C?"
    - "\uD560 \uC218 \uC788\uC5B4\uC694!"
    - "\uBD84\uBA85 \uB2E4\uC2DC \uC2DC\uC791 \uD560 \uC218 \uC788\uC5B4\uC694!"
    - "\uADF8...\uADF8\uB798..."
    - "\uB098 \uB2E4\uC2DC \uD55C \uBC88 \uC2DC\uC791\uD574\uBCFC\uAC8C."
    - "\uC815\uB9D0 \uACE0\uB9D9\uB2E4."
    - "(\uB0A8\uC790\uB294 \uD76C\uBBF8\uD558\uAC8C \uBBF8\uC18C\uC9D3\uACE0 \uC788\uB2E4.)"
