--- !u!114 &2143389855
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2143389853}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1b2971fbfd213a6419406fa613e4cffd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "\uC5B4! \uC544\uC800\uC528 \uB610 \uAC8C\uC784\uD574\uC694!"
    - "...\uB124? \uC774\uC81C \uB3CC\uC544\uAC00\uC57C \uD55C\uB2E4\uACE0\uC694?"
    - "\uADF8\uB798\uC694..."
    - "(\uC544\uC774\uB294 \uD480\uC774 \uC8FD\uC5B4\uC788\uB2E4.)"
    - "\uAC00\uAE30 \uC804\uC5D0 \uD558\uB098\uB9CC \uBB3C\uC5B4\uBD10\uB3C4 \uB3FC\uC694?"
    - "\uC800\uB3C4... \uC544\uC800\uC528 \uAC19\uC740 \uC0AC\uB78C\uC774 \uB420
      \uC218 \uC788\uC744\uAE4C\uC694..?"
    - "\uC800\uB3C4... \uC544\uC800\uC528 \uAC19\uC774 \uC774\uC720\uC5C6\uC774 \uB0A8\uC744
      \uB3C4\uC640\uC904 \uC218 \uC788\uB294  \uC0AC\uB78C\uC774 \uB420 \uC218 \uC788\uC744\uAE4C\uC694..?"
    - "...\uC751 \uBD84\uBA85 \uB420 \uC218 \uC788\uC5B4!"
    - "\uC815\uB9D0\uC694..? \uD5E4\uD5E4 \uB2E4\uD589\uC774\uB2E4."
    - "(\uC544\uC774\uB294 \uAE30\uBD84 \uC88B\uC740 \uB4EF \uC6C3\uACE0 \uC788\uB2E4...)"
    - "\uC544! \uC774\uAC70 \uC904\uAC8C\uC694!"
    - "(\uC544\uC774\uB294 \uB178\uB780\uC0C9 \uB3CC\uC744 \uAC74\uB0C8\uB2E4.)"
    - "\uC81C\uAC00 \uC18C\uC911\uD788 \uC5EC\uAE30\uB358 \uAC70\uC608\uC694!"
    sprites:
    - {fileID: 1527174429, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1308329385, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
