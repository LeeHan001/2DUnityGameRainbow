  m_Script: {fileID: 11500000, guid: 1b2971fbfd213a6419406fa613e4cffd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "\uC544\uC800\uC528 \uC548\uB155\uD558\uC138\uC694."
    - "\uC544\uC800\uC528 \uC774\uC81C \uAC00\uB294 \uAC70\uC608\uC694..?"
    - "...\uADF8\uB807\uAD6C\uB098"
    - "(\uC544\uC774\uB294 \uAC11\uC790\uAE30 \uB0A0 \uC548\uC544\uC92C\uB2E4.)"
    - "\uC804\uC5D0 \uC544\uC800\uC528\uAC00 \uD798\uB4E4\uBA74 \uC81C\uAC00 \uB3C4\uC640\uC900\uB2E4\uACE0
      \uD588\uC796\uC544\uC694!"
    - "\uC660\uC9C0 \uC544\uC800\uC528\uAC00 \uC9C0\uCCD0 \uBCF4\uC5EC\uC11C \uC548\uC544\uC92C\uC5B4\uC694!"
    - "\uD5E4\uD5E4 \uC544 \uB9DE\uB2E4! \uC774\uAC70 \uC904\uAC8C\uC694!"
    - "(\uC544\uC774\uB294 \uC8FC\uD669\uC0C9 \uB3CC\uC744 \uAC74\uB0C8\uB2E4.)"
    - "\uC544\uC800\uC528 \uC5EC\uAE30\uC11C \uC788\uC5C8\uB358 \uC77C\uC744 \uC78A\uC9C0
      \uB9D0\uC544\uC694!"
    - "\uC544\uC800\uC528\uAC00 \uADF8\uB7AC\uB358 \uAC83\uCC98\uB7FC \uC81C\uAC00
      \uD798\uB4E4\uBA74 \uB3C4\uC640\uC904\uAC8C\uC694!"
    - "(\uC544\uC774\uB294 \uBC1D\uAC8C \uC74F\uC73C\uBA70 \uB9D0\uD588\uB2E4.)"
    sprites:
    - {fileID: 1915189997, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
