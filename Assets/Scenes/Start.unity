    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_9:
    sentences:
    - ...
    - "\uC774\uAC83\uBC16\uC5D0 \uBABB \uB9DE\uCD94\uB2E4\uB2C8..."
    - "\uB354 \uACF5\uBD80\uD558\uACE0 \uC640\uB77C."
    - "(\uC120\uC0DD\uB2D8\uC740 \uBB34\uD45C\uC815\uC73C\uB85C \uB178\uB824\uBCF4\uACE0
      \uC788\uB2E4.)"
    sprites:
    - {fileID: 943033260, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
