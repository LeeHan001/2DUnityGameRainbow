  dialogue_2:
    sentences:
    - "\uB208 \uC18D\uC758 \uC22B\uC790...?"
    - "\uADF8\uB7EC\uACE0\uBCF4\uB2C8 \uC778\uD615\uC758 \uC548\uC5D0 \uBB34\uC2A8
