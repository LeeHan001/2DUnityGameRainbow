    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_10:
    sentences:
    - "...\t"
    - "\uC57C!!!"
    - "(\uC120\uC0DD\uB2D8\uC758 \uC5BC\uAD74\uC774 \uBB34\uC12D\uAC8C \uBCC0\uD588\uB2E4.)"
    - "\uC774\uB7F0 \uBA4D\uCCAD\uD55C \uB188 \uB10C \uB3C4\uB300\uCCB4 \uBB58 \uD55C\uAC70\uB0D0?!!!"
    - "\uB108\uAC19\uC740 \uB188\uC740 \uD544\uC694\uB3C4 \uC5C6\uC5B4!!! \uB2F9\uC7A5
      \uB2E4\uC2DC \uACF5\uBD80\uD574!!!"
    - "(\uC120\uC0DD\uB2D8\uC740 \uBB34\uC11C\uC6B4 \uC5BC\uAD74\uB85C \uC5EC\uAE38
      \uBCF4\uACE0\uC788\uB2E4.)"
    sprites:
    - {fileID: -454649723, guid: cb3cbb8a9fd94e4418cd535a767a6a2a, type: 3}
