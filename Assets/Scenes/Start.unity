  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "\uC800\uB9AC \uAC00\uC138\uC694..."
    - "(\uC544\uC774\uB294 \uC2AC\uD508 \uB4EF\uD55C \uD45C\uC815\uC744 \uC9D3\uACE0
      \uC788\uB2E4...)"
    sprites:
    - {fileID: 271397559, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 271397559, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_1:
    sentences:
    - "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC7A5\uB09C\uAC10 \uC790\uB3D9\uCC28\uB97C
      \uAC00\uC9C0\uACE0 \uC788\uB2E4."
    - "\uC7A5\uB09C\uAC10 \uC790\uB3D9\uCC28\uB97C \uC544\uC774\uC5D0\uAC8C \uC904\uAE4C?"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "(\uADF8\uB9CC\uB450\uC790...)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_3:
    sentences:
    - ...
    - "\uACE0\uB9D9\uC9C0\uB9CC \uC774\uAC74 \uB0B4\uAC00 \uC6D0\uD55C \uAC8C \uC544\uB2C8\uC5D0\uC694..."
    - "(\uC544\uC774\uB294 \uC2AC\uD508 \uD45C\uC815\uC744 \uC9C0\uC73C\uBA70 \uAC70\uBD80\uD588\uB2E4.)"
    sprites:
    - {fileID: 271397559, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 271397559, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 271397559, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_4:
    sentences:
    - "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC0AC\uD0D5\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4."
    - "\uC0AC\uD0D5\uC744 \uC544\uC774\uC5D0\uAC8C \uC904\uAE4C?"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_5:
    sentences:
    - "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC778\uD615\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4."
    - "\uC778\uD615\uC744 \uC544\uC774\uC5D0\uAC8C \uC904\uAE4C?"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_6:
    sentences:
    - "\uB2E4 \uD544\uC694 \uC5C6\uC73C\uB2C8\uAE4C \uC774\uC81C \uC880 \uAC00\uC138\uC694."
    - "(\uC544\uC774\uB294 \uC5EC\uC804\uD788 \uC2AC\uD508 \uD45C\uC815\uC744 \uC9D3\uACE0
      \uC788\uB2E4.)"
    - "\uC9C0\uAE08\uC774\uB77C\uBA74 \uC544\uC774\uB97C \uC548\uC544\uC904 \uC218
      \uC788\uC744 \uAC70 \uAC19\uB2E4."
    sprites:
    - {fileID: 271397559, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 271397559, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_7:
    sentences:
    - ...
    - "\uC73C\uC73C...\uC73C\uC544\uC559..."
    - "(\uC544\uC774\uB294 \uC6B8\uACE0 \uC788\uB2E4.)"
    - "\uB0B4...\uB0B4\uAC00 \uC6D0\uD55C \uAC74... \uADF8\uC800 \uAD00\uC2EC\uACFC
      \uC0AC\uB791\uC77C \uBFD0\uC774\uC5C8\uC5B4\uC694..."
    - "(\uBA87 \uBD84\uAC04 \uC544\uC774\uB97C \uC548\uC544\uC8FC\uC5C8\uB2E4.)"
    - "(\uC544\uC774\uB294 \uB208\uBB3C\uC744 \uBA48\uCD98\uB4EF\uD558\uB2E4.)"
    - "\uACE0\uB9C8\uC6CC\uC694...\uB09C \uC774\uC81C \uAD1C\uCC2E\uC544\uC694."
    - "(\uC544\uC774\uB294 \uD76C\uBBF8\uD558\uAC8C \uBBF8\uC18C\uC9D3\uACE0 \uC788\uB2E4.)"
    - "(\uC774\uC81C \uB2E4\uC74C \uC7A5\uC18C\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uC744\uAC70
