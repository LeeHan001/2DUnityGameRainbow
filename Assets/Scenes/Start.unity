--- !u!114 &1873344983
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1873344981}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 780ebe2ef158f5f40b6ee06714945d89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "\uC544\uC800\uC528! \uC544\uC800\uC528!"
    - "(\uAF2C\uB9C8\uAC00 \uB9D0\uC744 \uAC78\uC5B4\uC628\uB2E4.)"
    - "\uBB34\uC2A8 \uC77C\uC774\uB2C8?"
    - "\uBAA8\uB974\uB294 \uAC8C \uC788\uB294\uB370 \uBB3C\uC5B4\uBD10\uB3C4 \uB3FC\uC694?"
    - "\uADF8\uB798 \uBB3C\uC5B4\uBCF4\uB834."
    - "3 + 3\uC774 \uBB54\uC9C0 \uC54C\uC544\uC694?"
    - "6\uC774\uB780\uB2E4."
    - "\uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694!"
    - "(\uC544\uC774\uB294 \uC6C3\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: -1605133020, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1605133020, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1081913266, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 770997799, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1605133020, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 770997799, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
