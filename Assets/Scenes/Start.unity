--- !u!114 &285682290
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 285682288}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 780ebe2ef158f5f40b6ee06714945d89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "\uB0B4 \uC55E\uC5D0 \uAC70\uB300\uD55C \uAE08\uACE0\uAC00 \uBCF4\uC774\uB2C8??"
    - "\uBD84\uBA85 \uC800 \uAE08\uACE0\uC548\uC5D0 \uC5EC\uAE30\uC11C \uB098\uAC00\uB294
      \uBC29\uBC95\uC774 \uC788\uC744\uAC70\uC57C..."
    - "\uC5EC\uAE30\uC11C \uB098\uAC00\uACE0 \uC2F6\uC740\uAC00\uC694?"
    - "\uAE00\uC384...\uADF8\uB7F0 \uC0DD\uAC01\uC740 \uC548\uD574\uBD24\uB294\uB370..."
    - "(\uACE0\uBBFC\uD558\uB294 \uD45C\uC815\uC744 \uD558\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1081913266, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -281558445, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uAE08\uACE0 \uC606 \uC9C0\uC6CC\uC9C4 \uBB38\uC7A5\uC5D0 \uB300\uD574\uC11C
      \uC54C\uACE0 \uC2F6\uB2E4\uACE0..?"
    - "\uBD84\uBA85 \uC9C0\uC6CC\uC9C4 \uB0B4\uC6A9\uC740..."
    - "\uC88B\uC544\uD558\uB294 \uC22B\uC790? \uC600\uB358\uAC70 \uAC19\uC740\uB370..."
    - " \uC88B\uC544\uD558\uB294 \uC22B\uC790...?"
    - "\uCC38\uACE0\uB85C \uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uC22B\uC790\uB294
      3\uC774\uC57C~"
    - "(\uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uC22B\uC790\uB294 7\uC774\uB2E4...)"
    - "\uB9CC\uC57D \uAE08\uACE0\uB97C \uC5F4\uBA74 \uB098\uC5D0\uAC8C \uBB50\uAC00
      \uC788\uB294\uC9C0 \uC54C\uB824\uC918."
    - "(\uB0A8\uC790\uB294 \uBA4B\uCA4D\uC740 \uC6C3\uC74C\uACFC \uD568\uAED8 \uB9D0\uD588\uB2E4.)"
    sprites:
    - {fileID: -1603288133, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
