  target: {fileID: 98161256}
  dialogue_1:
    sentences:
    - "\uC774\uAC74...?"
    - "\uC694\uB78C? \uAC19\uB2E4..."
    - "\uC8FC\uBCC0\uC5D4 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uB294 \uAC83 \uAC19\uC73C\uB2C8\uAE4C.\r\n\uC694\uB78C\uC744
      \uAC74\uB4DC\uB824\uBCFC\uAE4C?"
    - "(\uC660\uC9C0 \uC694\uB78C\uC744 \uAC74\uB4DC\uB9AC\uBA74 \uB3CC\uC544\uC624\uAE30
      \uD798\uB4E4 \uAC83 \n\uAC19\uB2E4...)"
    sprites:
    - {fileID: -1081913266, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -569848446, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uC5EC\uAE34....?"
    - "\uC544\uBB34\uB798\uB3C4 \uC694\uB78C\uC758 \uC548\uC73C\uB85C \uB4E4\uC5B4\uC640\uBC84\uB9B0
      \uAC70 \n\uAC19\uB2E4..."
    - "(\uC5B4\uCA4C\uC9C0...? \uC77C\uB2E8 \uC8FC\uBCC0\uC744 \uD0D0\uC0C9\uD574\uBCF4\uC790..)"
    sprites:
    - {fileID: -1081913266, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
