--- !u!114 &1275798531
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1275798529}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ceb8cb6a1d80bd147b1e553d1b70a898, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "(\uD3C9\uBC94\uD55C \uCC45\uC0C1\uC774\uB2E4.)"
    - "(\uCC45\uC0C1\uC704\uC5D0\uB294 \uC885\uC774\uB4E4\uC774 \uC788\uB2E4.)"
    - "(\uC885\uC774\uC5D0\uB294 \uC774\uB807\uAC8C \uC801\uD600\uC838\uC788\uB2E4.)"
    - "\uC0C9\uAC01\uC774\uC0C1\uC740 \uC0C9\uC0C1\uC744 \uC798 \uAD6C\uBD84\uD558\uC9C0
      \n\uBABB\uD558\uB294 \uC99D\uC0C1\uC73C\uB85C \uC0C9\uB9F9\uACFC \uC0C9\uC57D\uC73C\uB85C
      \uAD6C\uBD84\uB41C\uB2E4."
    - "\uC0C9\uAC01\uC774\uC0C1\uC5D0\uB294 \uC5EC\uB7EC \uC885\uB958\uAC00 \uC788\uB2E4."
    - "\uB179\uC0C9\uB9F9\uACFC \uB179\uC0C9\uC57D\uC5D0\uAC8C \uC77C\uBD80 \uB179\uC0C9\uC740
      \r\n\uAC80\uC740\uC0C9\uC774\uB098 \uD68C\uC0C9\uC73C\uB85C \uBCF4\uC778\uB2E4."
    - "\uC801\uC0C9\uB9F9\uACFC \uC801\uC0C9\uC57D\uC5D0\uAC8C \uC9D9\uC740 \uBE68\uAC15\uC740
      \n\uAC80\uC740\uC0C9\uC774\uB098 \uD68C\uC0C9\uC73C\uB85C \uBCF4\uC778\uB2E4."
    - "\uC804\uC0C9\uB9F9\uACFC \uC804\uC0C9\uC57D\uC740 \uBAA8\uB4E0 \uC0C9\uC744
      \uAD6C\uBCC4\uD558\uAE30\n\uD798\uB4E4\uACE0 \uBAA8\uB4E0 \uC0C9\uC774 \uD751\uBC31\uC73C\uB85C
      \uBCF4\uC778\uB2E4."
    - "(\uC885\uC774\uC5D0 \uC801\uD600\uC9C4 \uB0B4\uC6A9\uC778 \uC774\uAC8C \uB2E4\uC778
      \uB4EF\uD558\uB2E4.)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
