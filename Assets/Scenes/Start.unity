    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue3:
    sentences:
    - "\uC544\uBB34\uB798\uB3C4 \uB2F5\uC774 \uC544\uB2CC \uAC83 \uAC19\uB2E4..."
    sprites:
    - {fileID: -569848446, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue4:
    sentences:
    - "\uC544\uBB34\uB798\uB3C4 \uB2F5\uC774 \uC544\uB2CC \uAC83 \uAC19\uB2E4..."
    - "\uBD84\uBA85 \uC67C\uCABD\uBD80\uD130 1\uBC88,2\uBC88,3\uBC88,4\uBC88\uC774\uC600\uACE0..."
    - "1\uBC88\uC740 \uC5EC\uAE30 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC758 \uC218\uC600\uC9C0...\n\uCD1D
      4\uBA85\uC774 \uC788\uB294 \uAC83 \uAC19\uC740\uB370...\uB098\uB3C4 \uD3EC\uD568\uD574\uC57C
      \uD558\uB098?"
    - "2\uBC88\uC740 \uBAA8\uB4E0 \uBE14\uB7ED\uC758 \uC218\uC778\uB370\n\uCD1D 8\uAC1C\uC600\uB358
      \uAC70 \uAC19\uB2E4."
    - "3\uBC88\uC740 \uB208 \uC18D\uC5D0 \uC788\uB2E4\uB294\uB370...\n\uADF8\uB7EC\uACE0
      \uBCF4\uB2C8 \uC778\uD615\uC758 \uB208\uC774 \uC880 \uC774\uC0C1\uD55C \uAC70
      \uAC19\uC740\uB370..."
    - "4\uBC88\uC740 \uAE08\uACE0 \uC544\uB798\uC5D0 \uC788\uB294 \uC0AC\uB78C\uC774
      \uC54C\uACE0\uC788\uB294\uAC70 \uAC19\uB2E4..."
    sprites:
    - {fileID: -569848446, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
