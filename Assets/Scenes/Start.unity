--- !u!114 &1906813657
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1906813655}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 780ebe2ef158f5f40b6ee06714945d89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "\uC4F0\uB808\uAE30\uD1B5\uC5D0\uB294 \uAC00\uB054 \uC4F8\uB9CC\uD55C \uAC8C
      \uC788\uC744\uC9C0\uB3C4..."
    - "(\uB0A8\uC790\uB294 \uC4F0\uB808\uAE30\uD1B5\uC744 \uBC14\uB77C\uBCF4\uACE0
      \uC788\uB2E4.)"
    sprites:
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uC2AC\uD37C\uD558\uB294 \uC0AC\uB78C\uC5D0\uAC8C\uB294 \uC548\uC544\uC8FC\uB294\uAC8C
      \uC88B\uC740\uAC70 \uAC19\uC544."
    - "(\uB0A8\uC790\uB294 \uBA4D\uD558\uB2C8 \uD558\uB298\uC744 \uBCF4\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_3:
    sentences:
    - "\uC544\uBB34 \uC0DD\uAC01 \uC5C6\uC774 \uC0AC\uB294 \uAC83\uB3C4 \uAD1C\uCC2E\uC740
      \uAC70 \uAC19\uC544."
    - "(\uB0A8\uC790\uB294 \uBA4D\uD558\uB2C8 \uB9D0\uD558\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
