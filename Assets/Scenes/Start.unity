--- !u!114 &1439833500
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1439833498}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1b2971fbfd213a6419406fa613e4cffd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "...\uC5B4\uB51C \uAC00\uB824\uACE0 \uD558\uB294\uAC70\uC57C?"
    - "\uC6D0\uB798 \uC788\uB358 \uC7A5\uC18C\uB85C \uAC08\uAC70\uB77C\uACE0..?"
    - "\uC6D0\uB798\uC788\uB358 \uACF3\uC740 \uC5C4\uCCAD \uD798\uB4E4\uACE0 \uACE0\uD1B5\uC2A4\uB7EC\uC6B8\uD150\uB370..? "
    - "\uADF8\uB798\uB3C4 \uB3CC\uC544\uAC08\uAC70\uC57C..?"
    - "...\uB124 \uC800\uB3C4 \uB2E4\uC2DC \uB3C4\uC804\uD574\uBD10\uC57C\uC8E0."
    - "\uADF8\uB807\uAD6C\uB098..."
    - "(\uB0A8\uC790\uB294 \uD76C\uBBF8\uD55C \uBBF8\uC18C\uB97C \uB744\uACE0 \uC788\uB2E4.)"
    - "\uC774\uAC78 \uB108\uC5D0\uAC8C \uC904\uAC8C."
    - "\uBAA8\uB4E0\uAC78 \uD3EC\uAE30 \uD558\uACE0 \uC2F6\uC744 \uB54C \uB3C4\uC640\uC904\uAC70\uC57C."
    - "(\uB0A8\uC790\uB294 \uD30C\uB780\uC0C9 \uB3CC\uC744 \uAC74\uB0C8\uB2E4.)"
    - "\uB108\uAC00 \uB098\uC5D0\uAC8C \uD574\uC900 \uB9D0, \uB2E4\uC2DC \uC2DC\uC791
      \uD560 \uC218 \uC788\uB2E4\uB294 \uB9D0."
    - "\uB108\uB3C4 \uBD84\uBA85 \uB2E4\uC2DC \uC2DC\uC791 \uD560 \uC218 \uC788\uC744\uAC70\uC57C."
    - "(\uB0A8\uC790\uB294 \uC5EC\uC804\uD788 \uD76C\uBBF8\uD55C \uBBF8\uC18C\uB97C
      \n\uB744\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: -1648388206, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1648388206, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
