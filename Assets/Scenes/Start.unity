  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "(\uD3C9\uBC94\uD55C \uCC45\uC0C1\uC774\uB2E4.)"
    - "(\uCC45\uC0C1\uC704\uC5D0\uB294 \uC885\uC774\uB4E4\uC774 \uC788\uB2E4.)"
    - "(\uC885\uC774\uC5D0\uB294 \uC774\uB807\uAC8C \uC801\uD600\uC838\uC788\uB2E4.)"
    - "\uAD11\uD559\uAE30\uAE30\uC5D0\uB294 \uC5EC\uB7EC\uAC00\uC9C0\uAC00 \uC788\uB2E4."
    - "\uB9DD\uC6D0\uACBD\uC740 \uBA3C \uACF3\uC758 \uC0AC\uBB3C\uC744 \uAD00\uCE21\uD560
      \uB54C \uC774\uC6A9\uD558\uB294 \uAD11\uD559\uAE30\uAD6C\uB97C \uB9D0\uD55C\uB2E4."
    - "\uD604\uBBF8\uACBD\uC740 \uD2B9\uC815 \uBB3C\uCCB4\uB97C \uD655\uB300\uD574\uC11C
      \n\uBCFC \uC218 \uC788\uB294 \uAE30\uACC4\uB2E4."
    - "\uB9CC\uD654\uACBD\uC740 \uC5EC\uB7EC\uC7A5 \uACB9\uCC98 \uAE34 \uD1B5\uC5D0
      \n\uC6D0\uC0C9\uC758 \uC870\uAC01\uC774\uB098 \uC54C\uB9F9\uC774\uB97C \uB123\uC5B4
      \n\uD22C\uBA85\uD55C \uC6A9\uAE30\uC5D0 \uBC00\uD3D0\uD574 \uB4E4\uC5EC\uB2E4
      \n\uBCF4\uB294 \uBB3C\uAC74\uC774\uB2E4."
    - "(\uC885\uC774\uC5D0 \uC801\uD600\uC9C4 \uB0B4\uC6A9\uC778 \uC774\uAC8C \uB2E4\uC778
      \uB4EF\uD558\uB2E4.)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
