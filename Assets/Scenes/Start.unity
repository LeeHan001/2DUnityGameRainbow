  dialogue_4:
    sentences:
    - "\uB3C4\uC640\uC918\uC11C \uACE0\uB9C8\uC6CC."
    - "(\uB0A8\uC790\uB294 \uCDA9\uC5F4\uB41C \uB208\uC73C\uB85C \uBBF8\uC18C\uB97C
      \uC9D3\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: -861671488, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
