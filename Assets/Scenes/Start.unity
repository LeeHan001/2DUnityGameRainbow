    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_1:
    sentences:
    - "\uAD50\uD0C1 \uC704\uC5D0 \uC788\uB294 \uC885\uC774\uC5D0\uC11C \uC0C1\uD638\uC791\uC6A9\uD558\uBA74
      \n\uC2DC\uD5D8\uC744 \uBCFC \uC218 \uC788\uC5B4\uC694!"
    - "\uBAA8\uB974\uB294 \uBB38\uC81C\uB294 \uCC45\uC0C1\uC5D0 \uC788\uB294 \uC885\uC774\uC5D0\uC11C\n\uC788\uC744\uC9C0\uB3C4
      \uBAB0\uB77C\uC694!"
    sprites:
    - {fileID: -100583280, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -100583280, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "(\uC18C\uB144\uC5D0\uAC8C \uB2F5\uC744 \uC54C\uB824\uC92C\uB2E4.)"
    - "\uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694! \uC774\uC81C\uC57C \uACA8\uC6B0 \uC9D1\uC5D0
      \uAC08 \uC218 \uC788\uACA0\uB2E4!"
    - "\uB098\uB3C4 \uC544\uC800\uC528\uCC98\uB7FC \uB611\uB611\uD574 \uC9C0\uACE0
      \uC2F6\uB2E4..."
    - "\uC544\uC800\uC528\uCC98\uB7FC \uB611\uB611\uD574\uC9C0\uB824\uBA74 \uACF5\uBD80
      \uB9CE\uC774 \uD574\uC57C\uACA0\uC8E0?"
    - "\uACF5\uBD80\uD558\uAE30 \uC2EB\uC740\uB370..."
    - "(\uC18C\uB144\uC740 \uC9C0\uB8E8\uD574\uBCF4\uC774\uB294 \uD45C\uC815\uC744
      \uC9D3\uACE0 \uC788\uB2E4.)"
    - "\uC544 \uCC38!"
    - "\uC774\uAC74 \uC81C \uBB38\uC81C\uC9D1\uC774\uC5D0\uC694! \uC544\uC800\uC528
      \uC904\uAC8C\uC694.\n\uCC98\uC74C\uC73C\uB85C \uB2E4 \uD47C \uBB38\uC81C\uC9D1\uC774\uB77C
      \uB298 \uAC00\uC9C0\uACE0 \n\uB2E4\uB2CC\uAC74\uB370 \uC544\uC800\uC528 \uC904\uAC8C\uC694!"
    - "(\uC798 \uBCF4\uAD00\uB41C \uBB38\uC81C\uC9D1\uC744 \uBC1B\uC558\uB2E4.)"
    - "(\uC778\uBCA4\uD1A0\uB9AC\uB97C \uD655\uC778\uD574\uBCF4\uC790.)"
    sprites:
    - {fileID: 770997799, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -315673079, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
