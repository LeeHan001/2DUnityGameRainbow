  dialogue_1:
    sentences:
    - "\uC5B4\uB514\uB85C \uAC04\uAC70\uC57C...\uC5B8\uC81C\uBD80\uD130\uC57C..."
    - "\uC800 \uAD6C\uBA4D\uC5D0 \uC788\uC744\uAC70\uC57C...\uC800 \uAD6C\uBA4D\uC5D0..."
    - "(\uB0A8\uC790\uB294 \uC5EC\uC804\uD788 \uC81C\uC815\uC2E0\uC774 \uC544\uB2CC
      \uB4EF \uD558\uB2E4.)"
    sprites:
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
