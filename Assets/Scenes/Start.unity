    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_3:
    sentences:
    - "...\uBB50?"
    - "\uC9C4\uC9DC \uADF8 \uC5C5\uBB34\uB97C \uB2E4 \uD55C\uAC70\uC57C?"
    - "\uB2E4\uD589\uC774\uB2E4...\uB108\uBB34 \uBC14\uBE60\uC11C \uB2E4 \uBABB\uD558\uB294
      \uC77C\uC774\uC5C8\uB294\uB370..."
    - "\uB108 \uB355\uBD84\uC5D0 \uBE68\uB9AC \uB05D\uB0BC \uC218 \uC788\uC5C8\uC5B4."
    - "\uADF8\uB7FC \uC57D\uC18D\uB300\uB85C \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5
      \uC911\uC694\uD55C \uAC78 \uC904\uAC8C."
    - "(\uB0A8\uC790\uB294 \uBB34\uC5B8\uAC00\uB97C \uAC74\uB0C8\uB2E4.)"
    - "(\uC778\uBCA4\uD1A0\uB9AC\uB97C \uD655\uC778\uD574 \uBCF4\uC790.)"
    sprites:
    - {fileID: 1814727977, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -2050144934, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
