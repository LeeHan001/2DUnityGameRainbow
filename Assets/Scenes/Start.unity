    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_1:
    sentences:
    - "...\uBB50\uC57C \uB10C"
    - "\uBC14\uC058\uB2C8\uAE4C \uAC00\uB77C."
    sprites:
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uBB50? \uB3C4\uC640\uC904\uAC8C \uC5C6\uB0D0\uACE0?"
    - "\uADF8\uB7FC \uCF1C\uC9C0\uC788\uB294 \uCEF4\uD4E8\uD130\uC5D0\uC11C \uC791\uC5C5\uC744
      \uC880 \uD574\uBD10."
    - "\uBB50 \uC5B4\uB5A4 \uCEF4\uD4E8\uD130\uC5D0\uC11C \uC791\uC5C5\uC744 \uD558\uB0D0\uACE0?"
    - "\uADF8\uAC74 \uB2C8\uAC00 \uC54C\uC544\uC11C \uD574\uC57C\uC9C0!"
    - "\uC544\uBB34\uD2BC \uCEF4\uD4E8\uD130\uB97C \uD0A4\uBA74 \uBB34\uC2A8 \uBC84\uD2BC\uC774
      \n\uB098\uC624\uB294\uB370 \uADF8\uAC78 10\uBC88 \uB20C\uB7EC!"
    - "(\uACFC\uC7A5\uC774\uB77C\uB294 \uB0A8\uC790\uB294 \uD654\uB97C \uB0B4\uACE0
      \uC788\uB2E4.)"
    sprites:
    - {fileID: -1603288133, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1201645860, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1201645860, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1201645860, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_3:
    sentences:
    - "\uC77C \uB2E4\uD588\uC73C\uBA74 \uBE68\uB9AC \uBD80\uC7A5\uB2D8\uD55C\uD14C
      \uBCF4\uACE0\uD574!"
    - "(\uB0A8\uC790\uB294 \uD654\uB97C \uB0B4\uBA70 \uC77C\uD558\uACE0 \uC788\uB2E4.)"
