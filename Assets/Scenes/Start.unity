    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_3:
    sentences:
    - "\uC544\uC800\uC528 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBAA8\uB974\uB294 \uAC70
      \uBB3C\uC5B4\uBD10\uB3C4 \uB3FC\uC694?"
    - "\uADF8\uB798 \uBB3C\uC5B4\uBCF4\uB834."
    - "(\uC774\uBC88\uC5D0\uB3C4 \uC26C\uC6B4 \uBB38\uC81C\uACA0\uC9C0.)"
    - "\uB9AC\uB9CC \uC81C\uD0C0 \uD568\uC218\uB97C \uB9CC\uC871\uD558\uB294 \uBAA8\uB4E0
      \uC790\uBA85\uD558\uC9C0 \uC54A\uC740 \uADFC\uC758 \uC2E4\uC218\uBD80\uB294
      1/2\uC774\uB2E4. \uC774 \uBB38\uC81C\uC758 \uC99D\uBA85\uC744 \uD574\uC8FC\uC138\uC694!"
    - "....\uBB50?"
    - "\uC124\uB9C8 \uBAA8\uB974\uB294 \uAC74 \uC544\uB2C8\uC8E0?"
    - "\uC74C...\uC0DD\uAC01 \uC880 \uD574\uBCFC\uAC8C..."
    - "(\uC544\uC774\uB294 \uC758\uC2EC\uC758 \uB208\uCD08\uB9AC\uB85C \uB0A0 \uBCF4\uACE0
      \uC788\uB2E4.)"
    sprites:
    - {fileID: 969925556, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 770997799, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
