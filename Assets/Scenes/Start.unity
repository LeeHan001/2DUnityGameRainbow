  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "\uC5EC\uAE34 \uB530\uB4EF\uD574\uC11C \uAE30\uBD84\uC774 \uC88B\uC544..."
    - "\uB108\uB3C4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uC9C0?"
    - "\uB530\uB4EF\uD558\uAE34 \uD558\uB124\uC694."
    - "\uADF8\uB807\uC9C0?"
    - "(\uB0A8\uC790\uB294 \uAE30\uBD84 \uC88B\uC740 \uB4EF\uC774 \uC6C3\uACE0 \uC788\uB2E4..)"
