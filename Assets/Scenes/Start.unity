  dialogue_3:
    sentences:
    - "\uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694!"
    - "\uB098\uB3C4 \uC544\uC800\uC528\uCC98\uB7FC \uB611\uB611\uD574 \uC9C0\uACE0
      \uC2F6\uC5B4\uC694!"
    - "\uADF8\uB7EC\uB824\uBA74 \uACF5\uBD80\uB97C \uB9CE\uC774 \uD574\uC57C\uACA0\uC8E0?"
    - "\uC800 \uC5F4\uC2EC\uD788 \uD560\uAC8C\uC694!"
    - "(\uC18C\uB144\uC758 \uD45C\uC815\uC740 \uC88B\uC544\uBCF4\uC778\uB2E4.)"
    sprites:
    - {fileID: -315673079, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
