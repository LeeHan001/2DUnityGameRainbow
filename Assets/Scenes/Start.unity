--- !u!114 &857721438
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 857721436}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1da9d7dc08d66d4b8c4f345baf179a2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "\uC73C...\uC73C..\uC73C\uC73C..."
    - "(\uB0A8\uC790\uB294 \uBA38\uB9AC\uB97C \uC950\uC5B4\uB72F\uC73C\uBA70 \uC2E0\uC74C\uC18C\uB9AC\uB97C
      \uB0B4\uACE0 \uC788\uB2E4.)"
    - "\uBCF4\uC9C0\uB9C8...\uB0A0 \uBCF4\uC9C0\uB9C8..."
    - "\uBB34\uC2A8 \uC77C\uC774\uC138\uC694?"
    - "\uB0A0 \uBCF4\uC9C0\uB9C8... \uC5B4\uB514\uB85C \uAC04\uAC70\uC9C0...\uC5B4\uB514\uC5D0
      \uC788\uB294 \n\uAC70\uC9C0..."
    - "\uBB58 \uCC3E\uACE0 \uC788\uB098\uC694?"
    - "\uADF8\uAC8C \uC0AC\uB77C\uC9C0\uACE0\uBD80\uD130 \uB0B4 \uC778\uC0DD\uC740
      \uC11C\uC11C\uD788 \n\uB9DD\uD574\uAC14\uACE0 \uC774\uC820 \uB3CC\uC774\uD0AC
      \uC218 \uC5C6\uC5B4...\n\uB0A0 \uBCF4\uC9C0\uB9C8...\uB0A0..."
    - "\uC800 \uAC70\uB300\uD55C \uAD6C\uBA4D \uC5B4\uB518\uAC00\uC5D0 \uC788\uC744\uAC70\uC57C...\uD558\uC9C0\uB9CC
      \uB09C \uAC08 \uC218 \uC5C6\uC5B4... \uB450\uB824\uC6CC...\uBB34\uC11C\uC6CC...\uB0A0
      \uBCF4\uC9C0\uB9C8..."
    - "(\uB0A8\uC790\uB294 \uC81C\uC815\uC2E0\uC774 \uC544\uB2CC \uB4EF \uD558\uB2E4.)"
    sprites:
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_1:
    sentences:
    - "\uC5B4\uB514\uB85C \uAC04\uAC70\uC57C...\uC5B8\uC81C\uBD80\uD130\uC57C..."
    - "\uC800 \uAD6C\uBA4D\uC5D0 \uC788\uC744\uAC70\uC57C...\uC800 \uAD6C\uBA4D\uC5D0..."
    - "(\uB0A8\uC790\uB294 \uC5EC\uC804\uD788 \uC81C\uC815\uC2E0\uC774 \uC544\uB2CC
      \uB4EF \uD558\uB2E4.)"
    sprites:
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uB0A8\uC790\uC5D0\uAC8C \uC774\uC0C1\uD55C \uBE5B\uC744 \uC92C\uB2E4."
    - "\uC73C...\uC73C\uC73C..."
    - "\uC5B4! \uC774...\uAC74?!!"
    - "(\uB0A8\uC790\uB294 \uAC11\uC790\uAE30 \uD070\uC18C\uB9AC\uB97C \uCCE4\uB2E4.)"
    - "\uC774\uAC74...\uB0B4\uAC00 \uC5B4\uB290\uC21C\uAC04 \uC783\uC5B4\uBC84\uB9B0
      \uAFC8..."
    - "\uC774\uAC8C \uC788\uC5C8\uC744 \uB54C\uB294 \uBB34\uC5C7\uB3C4 \uB450\uB835\uC9C0\uC54A\uACE0
      \n\uC990\uAC70\uC6E0\uC5C8\uB294\uB370..."
    - "\uB09C \uB2E4\uC2DC \uADF8 \uB54C\uB85C \uB3CC\uC544\uAC08 \uC218 \uC788\uC744\uAE4C..."
    - "\uADF8 \uB54C\uCC98\uB7FC \uB3C4\uC804\uD560 \uC218 \uC788\uC744\uAE4C?"
    - "\uD560 \uC218 \uC788\uC5B4\uC694!"
    - "\uBD84\uBA85 \uB2E4\uC2DC \uC2DC\uC791 \uD560 \uC218 \uC788\uC5B4\uC694!"
    - "\uADF8...\uADF8\uB798..."
    - "\uB098 \uB2E4\uC2DC \uD55C \uBC88 \uC2DC\uC791\uD574\uBCFC\uAC8C."
    - "\uC815\uB9D0 \uACE0\uB9D9\uB2E4."
    - "(\uB0A8\uC790\uB294 \uD76C\uBBF8\uD558\uAC8C \uBBF8\uC18C\uC9D3\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -246297232, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -510654942, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
