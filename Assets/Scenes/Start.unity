  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 780ebe2ef158f5f40b6ee06714945d89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_1:
    sentences:
    - "\uC5EC\uAE30\uB294 \uB204\uAD70\uAC00 \uB9CC\uB4E4\uC5B4\uB0B8 \uC138\uACC4..."
    - "\uB204\uAC00 \uB9CC\uB4E4\uC5C8\uB294\uC9C0\uB294 \uC544\uBB34\uB3C4 \uBAB0\uB77C..."
    - "\uADF8\uB9AC\uACE0 \uC774\uB7F0 \uC138\uACC4\uC758 \uBE44\uBC00\uC744 \uBC1D\uD600\uB0B4\uAE30
      \uC704\uD574 \uACE0\uBBFC\uD558\uB294 \uC8FC\uC778\uACF5..."
    - "\uC774\uB098\uC624\uB294 \uC560\uB2C8\uBA54\uC774\uC158\uC744 \uCD94\uCC9C\uD574\uC8FC\uC9C0
      \uC54A\uC744\uB798?"
    - ...?
    - "\uADF8\uB7F0 \uC560\uB2C8\uBA54\uC774\uC158\uC740 \uC798 \uBAA8\uB974\uACA0\uB124\uC694..."
    sprites:
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1794177222, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1081913266, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uC0AC\uC2E4 \uC6B0\uB9AC\uB4E4\uC740 \uBAA8\uB450 \uAE30\uC5B5\uC774\uB77C\uB294\uAC8C
      \uC5C6\uC5B4."
    - "\uADF8\uAC74 \uB108\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0..."
    - "\uB77C\uB294 \uC124\uC815\uC758 \uC18C\uC124\uC744 \uCD94\uCC9C\uD574\uC8FC\uC9C0
      \uC54A\uC744\uB798?"
    - "\uC74C...\uADF8\uB7F0 \uC18C\uC124\uC740 \uC798 \uBAA8\uB974\uACA0\uB124\uC694..."
    sprites:
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1193378714, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1794177222, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1433975987, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_3:
    sentences:
    - "\uB9CC\uC57D \uC774\uACF3\uC5D0\uC11C \uB098\uAC00\uBA74 \uBC16\uC740 \uC5B4\uB5A4\uC9C0
      \uC54C\uB824\uC918."
    - "\uC774\uBC88\uC5D4 \uBB50 \uCD94\uCC9C\uD574\uB2EC\uB77C\uACE0 \uC548\uD558\uB124\uC694?"
    - "\uC751 \uC774\uAC74 \uC9C4\uC2EC\uC73C\uB85C \uAD81\uAE08\uD55C\uAC70\uB2C8\uAE4C."
    - "(\uB0A8\uC790\uB294 \uAE30\uBD84 \uC88B\uC740 \uB4EF \uC6C3\uACE0 \uC788\uB2E4.)"
    sprites:
    - {fileID: -1794177222, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 680821734, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
