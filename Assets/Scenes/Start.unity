--- !u!114 &1848706022
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1848706020}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2d97d57cb2e6834f8b7416a7c7da1ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue_0:
    sentences:
    - "\uC548\uB155\uD558\uC138\uC694."
    - "\uC548\uB155\uD558\uC138\uC694."
    - "\uBC18\uAC11\uC2B5\uB2C8\uB2E4. \uC2E4\uB840\uAC00 \uC548\uB41C\uB2E4\uBA74
      \uD639\uC2DC \uC800 \uC880 \uB3C4\uC640\uC8FC\uC2DC\uACA0\uC5B4\uC694?"
    - "\uB124 \uBB3C\uB860\uC774\uC8E0!"
    - "(\uC720\uC77C\uD558\uAC8C \uC815\uC0C1\uC801\uC778 \uC0AC\uB78C\uC774\uB2E4...)"
    - "\uACC4\uB2E8\uC744 \uC62C\uB77C\uAC00\uBA74 \uC81C\uAC00 \uC0AC\uB294 \uACF3\uC774
      \uC788\uB294\uB370\n\uAC70\uAE30 \uC788\uB294 \uBC27\uC904\uC744 \uAC00\uC838\uC640
      \uC8FC\uC2DC\uACA0\uC5B4\uC694?"
    - "\uBC27\uC904\uC740 \uC5B4\uB514\uC5D0 \uC4F0\uC2DC\uAC8C\uC694?"
    - "\uD558\uD558 \uC4F8\uB370\uAC00 \uC880 \uC788\uC5B4\uC11C\uC694. \uAF2D \uC880
      \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. \uD558\uD558"
    - "(\uB0A8\uC790\uB294 \uC8FD\uC740 \uB208\uC73C\uB85C \uC6C3\uC73C\uBA70 \uB9D0\uD588\uB2E4.)"
    sprites:
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 770997799, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 770997799, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 770997799, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: -1081913266, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_1:
    sentences:
    - "\uC544\uBB34\uD2BC \uBC27\uC904\uC744 \uC880 \uAC00\uC838\uC640 \uC8FC\uC138\uC694."
    - "(\uB0A8\uC790\uB294 \uC8FD\uC740 \uB208\uC73C\uB85C \uC6C3\uC73C\uBA70 \uB9D0\uD588\uB2E4.)"
    - "(\uC790\uC138\uD788 \uBCF4\uB2C8 \uC190\uBAA9\uC5D0\uB294 \uC0C1\uCC98\uC790\uAD6D\uC774
      \uC788\uB2E4...)"
    sprites:
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
    dialogueWindows:
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
    - {fileID: 21300000, guid: cbbefe21e80cf3341a89996399aac10e, type: 3}
  dialogue_2:
    sentences:
    - "\uBC27\uC904\uC744 \uAC00\uC9C0\uACE0 \uC624\uC168\uAD70\uC694."
    - "\uC5B4\uC11C \uC774\uB9AC \uC8FC\uC138\uC694."
    - "\uBC27\uC904\uC744 \uC5B4\uB514\uC5D0 \uC4F0\uC2E4 \uAC74\uB370\uC694?"
    - "\uADF8\uAC74 \uC0C1\uAD00\uD560 \uBC14\uAC00 \uC544\uB2C8\uC796\uC544\uC694.
      \uC5B4\uC11C \uC8FC\uC138\uC694."
    - "\uD639\uC2DC \uC704\uD5D8\uD55C \uC0DD\uAC01\uC774\uB77C\uB3C4 \uD558\uB294
      \uAC74 \uC544\uB2C8\uC8E0?"
    - ...
    - "\uADF8\uB7EC\uC9C0 \uB9C8\uC138\uC694. \uC65C \uADF8\uB7F0 \uC0DD\uAC01\uC744
      \uD558\uB294\uAC70\uC5D0\uC694?"
    - "\uB2E4\uC2DC \uD55C \uBC88 \uC0DD\uAC01\uD574 \uBD10\uC694.\uB2F9\uC2E0\uC774
      \uC0B4\uC544\uC788\uC5B4\uC57C \uD560 \uC774\uC720\uB97C."
    - ...
    - "\uADFC\uB370 \uB10C \uC65C \uADF8\uB7F0\uAC70\uC57C."
    - "(\uB0A8\uC790\uB294 \uC8FD\uC740 \uB208\uC73C\uB85C \uBC14\uB77C\uBCF4\uBA70
      \uB9D0\uD588\uB2E4.)"
    - "...\uB124?"
    - "\uB10C \uC65C \uADF8\uB7F0 \uC120\uD0DD\uC744 \uD558\uB824\uACE0 \uD588\uB0D0\uACE0."
    - "\uBB34\uC2A8 \uC18C\uB9AC\uC5D0\uC694..?"
    - "\uB354 \uC774\uC0C1 \uB9D0\uD560 \uD544\uC694\uB294 \uC5C6\uACA0\uC9C0."
    - "...\uC77C\uB2E8 \uC774\uAC78 \uBC1B\uC544..."
    - "(\uB0A8\uC790\uB294 \uBCF4\uB77C\uC0C9 \uB3CC\uC744 \uAC74\uB0C8\uB2E4.)"
    - "\uB108\uAC00 \uAC00\uC57C \uD560 \uACF3\uC73C\uB85C \uB3CC\uC544\uAC00."
    - "\uB108\uB294 \uB108\uB9CC\uC774 \uAD6C\uD560 \uC218 \uC788\uC5B4."
    - "(\uB0A8\uC790\uB294 \uC758\uBBF8\uC2EC\uC7A5\uD558\uAC8C \uB9D0\uD588\uB2E4.)"
    sprites:
    - {fileID: 1359415202, guid: 4465e31745babb24d9ffa5c7ed2b0e86, type: 3}
